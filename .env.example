# FORGE Environment Configuration
FORGE_HOST=0.0.0.0
FORGE_PORT=8000
FORGE_DEBUG=true
FORGE_ENV=development

# Storage Paths
FORGE_DATA_DIR=data
FORGE_DATABASE_PATH=data/forge.db
FORGE_WORKSPACES_DIR=workspaces
FORGE_ARTIFACTS_DIR=artifacts

# Provider Settings (Options: direct, openai, anthropic, mock)
DEFAULT_PROVIDER=direct
DEFAULT_MODEL=direct-default
MODEL_TEMPERATURE=0.2

# LLM API Keys (Optional -- leave blank if unused)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=

# GitHub Integration & PR Automation
GITHUB_TOKEN=
GITHUB_REPO=

# Elevated token that may stand in for explicit git-push authorization.
# Leave blank in development; when blank no presented token can validate.
FORGE_GIT_PUSH_TOKEN=

# FRIDAY Universe Ecosystem Integrations
# Every value below MUST be supplied out-of-band. They are intentionally blank:
# committing placeholder credentials (the previous "inference_api" /
# "intelx_api" / "forge_api" values) trains operators to ship real secrets in
# plaintext and makes secret scanners fire on the template itself.
INFERENCE_URL=https://inference-h7bn.onrender.com
INFERENCE_API_KEY=

INTELX_URL=https://intelx-mygl.onrender.com
INTELX_API_KEY=

FUTURIS_URL=https://futuris-th6f.onrender.com
FUTURIS_API_KEY=

CORTEX_URL=https://cortex-0m7c.onrender.com
CORTEX_API_KEY=

# Forge's named agent credential for Memora Cloud.
FORGE_API_KEY=

# Set to true to require authentication on data endpoints. Defaults to true when
# FORGE_ENV=production.
API_KEY_REQUIRED=
