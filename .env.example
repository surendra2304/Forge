# FORGE Environment Configuration
FORGE_HOST=0.0.0.0
FORGE_PORT=8000
FORGE_DEBUG=true
FORGE_ENV=development

# Storage Paths
FORGE_DATA_DIR=data
# Oracle Autonomous Database only. PostgreSQL/SQLite are not supported.
# FORGE login/schema on the FRIDAY Universe DB; credentials are read at runtime.
FORGE_DATABASE_URL=oracle+oracledb://FORGE:password@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.REGION.oraclecloud.com))(connect_data=(service_name=SERVICE_NAME))(security=(ssl_server_dn_match=yes)))
# Legacy local file path, consulted only when FORGE_DATABASE_URL is unset (tests).
FORGE_DATABASE_PATH=data/forge.db
FORGE_WORKSPACES_DIR=workspaces
FORGE_ARTIFACTS_DIR=artifacts

# Provider Settings (Options: direct, openai, anthropic, mock)
DEFAULT_PROVIDER=direct
DEFAULT_MODEL=direct-default
MODEL_TEMPERATURE=0.2

# LLM API Keys (Optional -- leave blank if unused)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=

# GitHub Integration & PR Automation
GITHUB_TOKEN=
GITHUB_REPO=

# Elevated token that may stand in for explicit git-push authorization.
# Leave blank in development; when blank no presented token can validate.
FORGE_GIT_PUSH_TOKEN=

# FRIDAY Universe Ecosystem Integrations (friday_mesh private container network)
INFERENCE_URL=http://inference:8000
INFERENCE_API_KEY=

INTELX_URL=http://intelx:8000
INTELX_API_KEY=

FUTURIS_URL=http://futuris:8000
FUTURIS_API_KEY=

CORTEX_URL=http://cortex:8000
CORTEX_API_KEY=

MEMORA_URL=http://memora:8000
MEMORA_API_KEY=

# Forge's named agent credential for peer agent authentication
FORGE_API_KEY=

# FRIDAY Core Gateway
FRIDAY_URL=http://friday:10000
FRIDAY_API_KEY=

# Set to true to require authentication on data endpoints. Defaults to true when
# FORGE_ENV=production.
API_KEY_REQUIRED=true

# --- AGENT 10 VYRALX MESH ---
VYRALX_URL=http://vyralx:8000
VYRALX_API_KEY=
