# FORGE Environment Configuration

# Server
FORGE_HOST=0.0.0.0
FORGE_PORT=8000
FORGE_DEBUG=true
FORGE_ENV=development

# Storage Paths
FORGE_DATA_DIR=data
FORGE_DATABASE_PATH=data/forge.db
FORGE_WORKSPACES_DIR=workspaces
FORGE_ARTIFACTS_DIR=artifacts

# Provider Settings
FORGE_DEFAULT_PROVIDER=direct
FORGE_DEFAULT_MODEL=direct-default
FORGE_MODEL_TEMPERATURE=0.2

# Direct Provider / LLM Keys (Optional / Provider-specific)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
