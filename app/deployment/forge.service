[Unit]
Description=Forge Autonomous Software Synthesizer & Verification Battery (FRIDAY Universe)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/friday_universe/Forge
EnvironmentFile=/etc/default/friday_universe.env
ExecStart=/opt/friday_universe/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8006 --workers 1
Restart=always
RestartSec=5s
MemoryMax=180M
MemoryHigh=150M
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
